    bam_fee_cfg["bam_fee_cfg shared object"]:::control
    bank_busy["bank_busy fseq"]:::control
    pohh_shred["pohh_shred fseq"]:::control
    bam -- writes --> bam_status
    fd_quic -- reads --> bam_status
    fd_verify -- mapped read-only --> bam_status
    fd_bundle -- reads --> bam_status
    bam -- reads/writes --> bam_ctrl
    bam -- writes --> bam_fee_cfg
    fd_pack -- reads --> bam_fee_cfg
    pohh -- writes --> bank_busy
    fd_pack -- reads --> bank_busy
    pohh -- writes --> pohh_shred
    fd_shred -- reads --> pohh_shred
  end

