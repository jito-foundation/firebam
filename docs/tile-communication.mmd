  subgraph fdctl_bam["Current BAM overlay: src/app/fdctl/topology.c only"]
    bam_ext["BAM scheduler gRPC/TLS"]:::external
    bam["bam tile"]:::bam
    fd_quic["quic"]
    fd_verify["verify tiles"]
    fd_dedup["dedup"]
    resolh["resolh tiles"]
    fd_pack["pack"]
    bank["bank tiles"]
    pohh["pohh"]
    fd_shred["shred tiles"]
    fd_sign["sign/keyguard"]
    plugin["plugin/gui"]:::optional
    be["Block Engine gRPC/TLS"]:::external
    fd_bundle["bundle"]:::optional

    be --> fd_bundle
    fd_bundle -- bundle_verif --> fd_verify
    fd_quic -- quic_verify --> fd_verify
    bam_ext --> bam
    bam -- bam_verif --> fd_verify
    fd_verify -- verify_dedup --> fd_dedup
    fd_dedup -- dedup_resolh --> resolh
    resolh -- resolh_pack --> fd_pack
    fd_pack -- pack_bank --> bank
    fd_pack -- pack_pohh --> pohh
    bank -- bank_pohh --> pohh
    pohh -- pohh_shred --> fd_shred

    fd_pack -- pack_bam_ldr latest snapshots --> bam
    fd_pack -- pack_bam_res durable results --> bam
    bank -- bank_bam durable results --> bam
    fd_verify -- bank_bam verify failures --> bam
